datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  price       Float
  image       String
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
}
